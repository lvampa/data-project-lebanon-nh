# Copy this to .env and adjust as needed for local development.
# Non-secret values here are the defaults used when they are unset.
# Secrets have no default, and docker compose refuses to start until they are set.
# Generate passwords and tokens with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Hex keeps them safe inside the Airflow database URL.
# Postgres and Mongo only read their password when their data volume is first created.
# If you already have those volumes, keep the passwords they were created with.

# MongoDB
MONGO_USER=admin
MONGO_PASSWORD=
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=scraped_data

# PostgreSQL
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
# Used by tools/report-gen. scripts/generate_report.sh builds it from the
# POSTGRES_* values above when unset, so only set it to point somewhere else.
# Percent-encode special characters in the password (@ is %40, / is %2F).
# DATABASE_URL=postgresql://app:app@localhost:5432/app

# Airflow
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=
# Generate with: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=

# API
# Bearer token required on PATCH routes.
# Set the same value in frontend/admin/.env.local so the admin app can send it.
ADMIN_API_TOKEN=
# Contact email or URL for the Nominatim User-Agent, which its usage policy requires.
# Falls back to the repo URL when unset.
# NOMINATIM_CONTACT=

# Scrapy (optional dev flags)
# Uncomment to cache HTTP responses for 24h — avoids re-downloading PDFs during dev
# SCRAPY_HTTPCACHE=1

# Logfire (optional) — https://logfire.pydantic.dev/docs/reference/configuration/
# Local dev: run `uv run logfire auth` (credentials go in ~/.logfire, not here).
# Use LOGFIRE_TOKEN only in CI/headless setups; do not commit real tokens.
# LOGFIRE_TOKEN=
# LOGFIRE_SERVICE_NAME=scrapers
# LOGFIRE_ENVIRONMENT=development
# LOGFIRE_SEND_TO_LOGFIRE=true
