# Dummy values for CI only. compose.yml refuses to start without these secrets.
# Nothing here is used outside a throwaway CI runner.
COMPOSE_PROJECT_NAME=ci
POSTGRES_USER=app
POSTGRES_PASSWORD=ci-postgres
POSTGRES_DB=app
MONGO_PASSWORD=ci-mongo
AIRFLOW_PASSWORD=ci-airflow
# A valid Fernet key, all zero bytes, so Airflow accepts it.
AIRFLOW_FERNET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
AIRFLOW_SECRET_KEY=ci-airflow-secret
ADMIN_API_TOKEN=ci-admin-token
LOGFIRE_SEND_TO_LOGFIRE=false
