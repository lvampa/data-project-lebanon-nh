FROM apache/airflow:2.10.4

RUN pip install --no-cache-dir uv==0.10.4

USER root
RUN mkdir -p /opt/project && chown airflow /opt/project
USER airflow

WORKDIR /opt/project

# Copy workspace definition and all member pyproject.toml files
COPY --chown=airflow pyproject.toml uv.lock ./
COPY --chown=airflow scrapers/pyproject.toml ./scrapers/
COPY --chown=airflow api/pyproject.toml ./api/

# shared/* and scripts/ need their source to build. The volume mounts overlay them at runtime.
COPY --chown=airflow shared/mongo ./shared/mongo/
COPY --chown=airflow shared/postgres ./shared/postgres/
COPY --chown=airflow scripts ./scripts/

RUN uv sync --frozen --package scrapers --package scripts

# scrape_llcs and scrape_civicclerk drive Chromium. The browser goes in the airflow
# user's cache; its system libraries need root.
RUN .venv/bin/playwright install chromium
USER root
RUN /opt/project/.venv/bin/playwright install-deps chromium
# mongodump and mongorestore, for the MongoDB backup DAG. Debian does not package
# MongoDB's tools, so they come from MongoDB's own repository, matching mongo:8.
RUN curl -fsSL https://pgp.mongodb.com/server-8.0.asc \
        | gpg --dearmor -o /usr/share/keyrings/mongodb-server-8.0.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/mongodb-server-8.0.gpg] http://repo.mongodb.org/apt/debian bookworm/mongodb-org/8.0 main" \
        > /etc/apt/sources.list.d/mongodb-org-8.0.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends mongodb-database-tools \
    && rm -rf /var/lib/apt/lists/*
# pg_dump, for the PostgreSQL backup script. Debian bookworm packages version 15,
# and pg_dump refuses a newer server, so version 16 comes from the PostgreSQL
# repository, matching postgres:16.
RUN curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        | gpg --dearmor -o /usr/share/keyrings/postgresql.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/postgresql.gpg] http://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-16 \
    && rm -rf /var/lib/apt/lists/*
USER airflow

WORKDIR /opt/airflow
