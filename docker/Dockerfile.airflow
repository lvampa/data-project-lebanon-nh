# syntax=docker/dockerfile:1
# report-gen, built here so the Airflow image needs no Rust toolchain. Trixie matches the
# Airflow image's libc. Keep the version the same as the Rust job in ci.yml.
FROM rust:1.100.0-trixie AS report-gen
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY tools/report-gen ./tools/report-gen/
RUN cargo build --release --locked -p report-gen

FROM apache/airflow:3.4.0-python3.12

# The base image ships an older uv in the airflow user's .local/bin, ahead of /bin on PATH.
# Overwrite it, so the builds and every DAG task run this version.
COPY --from=ghcr.io/astral-sh/uv:0.13.10 --chown=50000:0 /uv /uvx /home/airflow/.local/bin/

# The base image's users by number: root is 0 and airflow is 50000.
USER 0
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# pg_dump, unzip and gzip. pg_dump is for the PostgreSQL backup script. Debian trixie packages
# version 17, and pg_dump refuses a newer server, so version 16 comes from the PostgreSQL
# repository, matching postgres:16. unzip is for the aws CLI below, and
# gzip is for tar to unpack the MongoDB tools, which the hardened base image leaves out.
RUN curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        | gpg --dearmor -o /usr/share/keyrings/postgresql.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/postgresql.gpg] http://apt.postgresql.org/pub/repos/apt trixie-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-16 unzip gzip \
    && rm -rf /var/lib/apt/lists/*

# mongodump and mongorestore, for the hand-run MongoDB backup script. They have to match
# mongo:8.3. MongoDB's apt repository has no arm64 Debian packages, so this takes MongoDB's
# prebuilt tools tarball instead, which works on both architectures. The ubuntu2204 build is
# the only one published for arm64 (debian13 has an x86_64 build only), and its glibc 2.35 is older than trixie's 2.41. The
# version is pinned and each tarball is checked against its sha256. Bump the version by hand,
# and update both checksums with it (https://downloads.mongodb.org/tools/db/release.json).
ARG MONGO_TOOLS_VERSION=100.20.1
RUN case "$(uname -m)" in \
        x86_64) arch=x86_64; sha256=2d56bb351383f7a42ffb866666631da8b7bcd82503b273e0c16d3be201ad12c1 ;; \
        aarch64) arch=arm64; sha256=02e492384155af7d0623148668bc9eaf228529c32555e33d450b3ec18c8dcdd0 ;; \
        *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://fastdl.mongodb.org/tools/db/mongodb-database-tools-ubuntu2204-${arch}-${MONGO_TOOLS_VERSION}.tgz" -o /tmp/mongo-tools.tgz \
    && echo "${sha256}  /tmp/mongo-tools.tgz" | sha256sum -c - \
    && mkdir /tmp/mongo-tools \
    && tar -xzf /tmp/mongo-tools.tgz -C /tmp/mongo-tools --strip-components=1 \
    && cp /tmp/mongo-tools/bin/mongodump /tmp/mongo-tools/bin/mongorestore /usr/local/bin/ \
    && rm -rf /tmp/mongo-tools /tmp/mongo-tools.tgz \
    && mongodump --version \
    && mongorestore --version

# The aws CLI, for scripts/deploy-data.sh to sync the export to R2. Version 2 is a bundled
# binary, so it cannot clash with the boto packages Airflow pins. The version is pinned, so a
# new release cannot change what runs with the R2 keys. Bump it by hand.
ARG AWSCLI_VERSION=2.42.5
RUN curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$(uname -m)-${AWSCLI_VERSION}.zip" -o /tmp/awscli.zip \
    && unzip -q /tmp/awscli.zip -d /tmp \
    && /tmp/aws/install \
    && rm -rf /tmp/aws /tmp/awscli.zip

RUN mkdir -p /opt/project && chown airflow /opt/project

# The cache mount is on another filesystem than the venv, so uv has to copy, not link.
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /opt/project
USER 50000

# The lockfile and every workspace member's pyproject.toml, enough to install the
# dependencies. A source change then skips that layer.
COPY --chown=airflow pyproject.toml uv.lock ./
COPY --chown=airflow scrapers/pyproject.toml ./scrapers/
COPY --chown=airflow api/pyproject.toml ./api/
COPY --chown=airflow scripts/pyproject.toml ./scripts/
COPY --chown=airflow shared/bootstrap/pyproject.toml ./shared/bootstrap/
COPY --chown=airflow shared/locations/pyproject.toml ./shared/locations/
COPY --chown=airflow shared/mongo/pyproject.toml ./shared/mongo/
COPY --chown=airflow shared/postgres/pyproject.toml ./shared/postgres/
# The cache is in /tmp, set on the command and not in ENV, because BuildKit would create a
# missing ~/.cache as root and Playwright then could not write its browser there. ENV would
# also point every DAG task's uv at a root-owned folder.
RUN --mount=type=cache,target=/tmp/uv-cache,uid=50000,gid=0 \
    UV_CACHE_DIR=/tmp/uv-cache uv sync --frozen --no-install-workspace --package scrapers --package scripts

# scrape_llcs and scrape_civicclerk drive Chromium. The browser goes in the airflow
# user's cache; its system libraries need root. This sits before the source COPYs, so a
# code change keeps these layers. The playwright package comes from the sync above.
RUN .venv/bin/playwright install chromium
USER 0
RUN /opt/project/.venv/bin/playwright install-deps chromium
USER 50000

# shared/* and scripts/ need their source to build. The volume mounts overlay them at runtime.
COPY --chown=airflow shared/bootstrap ./shared/bootstrap/
COPY --chown=airflow shared/locations ./shared/locations/
COPY --chown=airflow shared/mongo ./shared/mongo/
COPY --chown=airflow shared/postgres ./shared/postgres/
COPY --chown=airflow scripts ./scripts/
RUN --mount=type=cache,target=/tmp/uv-cache,uid=50000,gid=0 \
    UV_CACHE_DIR=/tmp/uv-cache uv sync --frozen --package scrapers --package scripts

COPY --from=report-gen /build/target/release/report-gen /usr/local/bin/report-gen
ENV REPORT_GEN_BIN=/usr/local/bin/report-gen
USER 50000

WORKDIR /opt/airflow
