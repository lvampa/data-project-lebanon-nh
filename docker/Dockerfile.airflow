FROM apache/airflow:2.10.4

RUN pip install --no-cache-dir uv==0.4.29

USER root
RUN mkdir -p /opt/project && chown airflow /opt/project
USER airflow

WORKDIR /opt/project

# Copy workspace definition and all member pyproject.toml files
COPY --chown=airflow pyproject.toml uv.lock ./
COPY --chown=airflow scrapers/pyproject.toml ./scrapers/
COPY --chown=airflow api/pyproject.toml ./api/

# shared/* packages need their source to build — volume mount overlays at runtime
COPY --chown=airflow shared/mongo ./shared/mongo/
COPY --chown=airflow shared/postgres ./shared/postgres/

RUN uv sync --frozen --package scrapers

WORKDIR /opt/airflow
