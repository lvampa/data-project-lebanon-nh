# syntax=docker/dockerfile:1
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.13.10 /uv /uvx /bin/

# The cache mount is on another filesystem than the venv, so uv has to copy, not link.
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /opt/project

# The dependencies first, from the lockfile and the pyproject files, so a source change
# does not reinstall them.
COPY pyproject.toml uv.lock ./
COPY api/pyproject.toml ./api/
COPY scrapers/pyproject.toml ./scrapers/
COPY scripts/pyproject.toml ./scripts/
COPY shared/bootstrap/pyproject.toml ./shared/bootstrap/
COPY shared/locations/pyproject.toml ./shared/locations/
COPY shared/mongo/pyproject.toml ./shared/mongo/
COPY shared/postgres/pyproject.toml ./shared/postgres/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-workspace --package api

COPY api/ ./api/
COPY shared/bootstrap ./shared/bootstrap/
COPY shared/locations ./shared/locations/
COPY shared/mongo ./shared/mongo/
COPY shared/postgres ./shared/postgres/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --package api

CMD ["uv", "run", "--frozen", "uvicorn", "--factory", "api.main:create_app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
