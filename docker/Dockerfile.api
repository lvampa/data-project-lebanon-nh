FROM python:3.12-slim

RUN pip install --no-cache-dir uv==0.4.29

WORKDIR /opt/project

COPY pyproject.toml uv.lock ./
COPY api/ ./api/
COPY scrapers/pyproject.toml ./scrapers/
COPY shared/mongo ./shared/mongo/
COPY shared/postgres ./shared/postgres/

RUN uv sync --frozen --package api

CMD ["uv", "run", "--frozen", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
