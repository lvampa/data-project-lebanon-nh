# MongoDB
MONGO_USER=admin
MONGO_PASSWORD=changeme
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=scraped_data

# Airflow
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=changeme

# Scrapy (optional dev flags)
# Uncomment to cache HTTP responses for 24h — avoids re-downloading PDFs during dev
# SCRAPY_HTTPCACHE=1

# Logfire (optional) — https://logfire.pydantic.dev/docs/reference/configuration/
# Local dev: run `uv run logfire auth` (credentials go in ~/.logfire, not here).
# Use LOGFIRE_TOKEN only in CI/headless setups; do not commit real tokens.
# LOGFIRE_TOKEN=
# LOGFIRE_SERVICE_NAME=scrapers
# LOGFIRE_ENVIRONMENT=development
# Set to false to disable sending spans to Logfire (e.g. local runs)
# LOGFIRE_SEND_TO_LOGFIRE=true

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
